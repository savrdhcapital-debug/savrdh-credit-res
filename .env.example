# SAVRDH Credit Resolution - production environment template
NODE_ENV="production"
APP_URL="https://your-app-domain.example"

# Never put real secrets in this file or commit them to GitHub.
# Configure them in your hosting provider's encrypted Environment Variables / Secrets panel.

# AI (optional diagnostic assistant)
GEMINI_API_KEY=""

# Database (required for persistent customer / CRM data)
MONGODB_URI=""
MONGODB_DB_NAME="savrdh_credit_resolution"

# Authentication/session signing (required; use a long random value)
SESSION_SECRET=""

# Razorpay (required before accepting real payments)
RAZORPAY_KEY_ID=""
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# OTP / SMS - configure one supported provider before production launch
SMS_PROVIDER="fast2sms"
SMS_API_KEY=""
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWOFACTOR_API_KEY=""
CUSTOM_SMS_GATEWAY_URL=""
SMS_SENDER_ID="SAVRDH"

# Development-only escape hatch. MUST remain false in production.
ALLOW_DEMO_MODE="false"
