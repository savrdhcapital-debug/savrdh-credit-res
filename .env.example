# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# EMAIL & SMTP CONFIGURATION (support@savrdhfinancialservices.com)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="support@savrdhfinancialservices.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="support@savrdhfinancialservices.com"
SMTP_FROM_NAME="Savrdh Financial Services"
ADMIN_NOTIFICATION_EMAIL="savrdhcapital@gmail.com,support@savrdhfinancialservices.com"

# ==============================================================================
# CIBIL & CREDIT BUREAU API CONFIGURATION (Optional 3rd-Party Bureau API)
# ==============================================================================
CIBIL_API_KEY=""
CIBIL_API_ENDPOINT=""

# ==============================================================================
# Razorpay Key ID (Public Key, e.g., rzp_live_TQHEkj6YSEakhk)
RAZORPAY_KEY_ID="rzp_live_TQHEkj6YSEakhk"
VITE_RAZORPAY_KEY_ID="rzp_live_TQHEkj6YSEakhk"

# Razorpay Key Secret (Server-side Secret Key)
RAZORPAY_KEY_SECRET=""

# ==============================================================================
# SMS & OTP GATEWAY CONFIGURATION
# ==============================================================================
# Choose your SMS provider: 'fast2sms' | 'msg91' | '2factor' | 'twilio' | 'generic'
SMS_PROVIDER="fast2sms"

# Universal SMS Gateway API Key (used for Fast2SMS or 2Factor)
SMS_API_KEY=""

# Fast2SMS Specific (if using Fast2SMS Quick/DLT OTP Route)
FAST2SMS_API_KEY=""

# MSG91 Specific
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# 2Factor Specific
TWOFACTOR_API_KEY=""

# Twilio Specific (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Generic Custom SMS Gateway URL (Optional)
# Supports placeholders: {mobile}, {otp}, {message}
CUSTOM_SMS_GATEWAY_URL=""

